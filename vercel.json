{
  "version": 2,
  "builds": [
    {
      "src": "api/[[...route]].js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/[[...route]].js"
    },
    {
      "src": "/brand/(trend-radar-(?:logo|banner)-en\\.png)",
      "dest": "/public/brand/$1"
    },
    {
      "src": "/(app\\.js|style\\.css|reset\\.css)",
      "dest": "/public/$1"
    },
    {
      "src": "/(?:index\\.html)?",
      "dest": "/public/index.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
