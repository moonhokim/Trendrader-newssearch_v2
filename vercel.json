{
  "version": 2,
  "builds": [
    {
      "src": "api/[[...route]].js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/[[...route]].js"
    },
    {
      "src": "/(app\\.js|style\\.css|reset\\.css|bg\\.jpg)",
      "dest": "/public/$1"
    },
    {
      "src": "/",
      "dest": "/public/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
