# Optional server-side credentials. Never put keys in app.js or index.html.
YOUTUBE_API_KEY=
GITHUB_TOKEN=
# Optional approved Reddit OAuth access token; refresh it when expired.
REDDIT_ACCESS_TOKEN=
# Set your real application/contact identity, e.g. web:myapp:v1 (by /u/your_account)
REDDIT_USER_AGENT=
# 0.0.0.0 lets other devices on the same network access this server.
HOST=0.0.0.0
PORT=3000
