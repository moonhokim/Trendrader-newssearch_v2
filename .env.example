# Optional server-side credentials. Never put keys in app.js or index.html.
YOUTUBE_API_KEY=
GITHUB_TOKEN=
# Optional approved Reddit OAuth access token; refresh it when expired.
REDDIT_ACCESS_TOKEN=
# Set your real application/contact identity, e.g. web:myapp:v1 (by /u/your_account)
REDDIT_USER_AGENT=
# 0.0.0.0 lets other devices on the same network access this server.
HOST=0.0.0.0
PORT=3000
# Feed board configuration (server only; never commit real values).
BOARD_GITHUB_TOKEN=
BOARD_GITHUB_REPOSITORY=moonhokim/Trendrader-newssearch_v2
BOARD_GITHUB_BRANCH=main
BOARD_ADMIN_PASSWORD=
BOARD_PASSWORD_PEPPER=
# Optional visitor counting Redis REST credentials (server only).
# Vercel Upstash integration KV_REST_API_URL/TOKEN or UPSTASH_REDIS_REST_URL/TOKEN are also supported.
VISITOR_REDIS_REST_URL=
VISITOR_REDIS_REST_TOKEN=
